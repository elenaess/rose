<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>
    <queries>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <package android:name="com.termux"/>
    </queries>
    <application android:label="Sakura" android:icon="@mipmap/sakura_icon" android:roundIcon="@mipmap/sakura_icon" android:theme="@style/RoseTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask"
            android:enableOnBackInvokedCallback="false" android:windowSoftInputMode="adjustResize"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.HOME"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:name=".TerminalResult" android:exported="false"/>
    </application>
</manifest>
